  ></div>

  <!-- GRID -->
  <div
    class="background-grid pointer-events-none fixed inset-0 z-[2]"
  ></div>

  <!-- TOP BAR -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl flex-col gap-4 px-6 pt-6 md:grid md:grid-cols-[1fr_auto_1fr] md:items-center md:px-10"
  >
    <span
      class="text-center text-[10px] lowercase tracking-[0.16em] text-[#aaa69b] md:text-left md:text-xs md:tracking-[0.2em]"
    >
      nightlampexecute.com
    </span>

    <nav
      class="flex items-center justify-center gap-3 whitespace-nowrap text-xs lowercase tracking-[0.16em] text-[#f2eee3] md:tracking-[0.2em]"
      aria-label="Main navigation"
    >
      <a
        href="/"
        class="text-[#ffd800] underline underline-offset-4"
        aria-current="page"
      >
        home
      </a>

      <span class="text-[#77736b]" aria-hidden="true">
        /
      </span>

      <a
        href="/press"
        class="transition-colors hover:text-[#ffd800]"
      >
        press
      </a>
    </nav>

    <span
      class="text-center text-[10px] lowercase tracking-[0.16em] text-[#aaa69b] md:text-right md:text-xs md:tracking-[0.2em]"
    >
      a product of Limerick City, Ireland
    </span>
  </div>

  <!-- HERO -->
  <div
    class="relative z-10 mx-auto flex min-h-[68vh] w-full max-w-7xl flex-col justify-center px-6 py-16 md:min-h-[72vh] md:px-10 md:py-20"
  >
    <h1
      class="nightlamp-title nightlamp-home-title max-w-full text-[#f2eee3]"
    >
      nightlamp.exe
    </h1>

    <div
      class="mt-10 max-w-2xl border-l border-[#ffd800] bg-[#050505]/30 pl-5 backdrop-blur-[2px] md:mt-12"
    >
      <p
        class="text-lg font-normal leading-relaxed text-[#f2eee3] sm:text-xl md:text-2xl"
      >
        nightlamp.exe is an independent electronic project working across
        industrial-influenced IDM, breakcore and experimental club music.
      </p>
    </div>
  </div>

  <!-- SCORIA 24-26 -->
  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-20 md:px-10 md:pb-28"
  >
    <div class="mb-5 flex items-center gap-4">
      <span
        class="text-sm lowercase tracking-[0.16em] text-[#f2eee3] md:tracking-[0.2em]"
      >
        scoria 24-26
      </span>

      <div class="h-px flex-1 bg-[#5f561f]"></div>
    </div>

    <div
      class="border border-[#5f561f] bg-[#050505]/75 backdrop-blur-[3px]"
    >
      <!-- RELEASE HEADER -->
      <div
        class="flex flex-col gap-5 border-b border-[#5f561f] p-5 sm:p-6 md:flex-row md:items-end md:justify-between md:p-10"
      >
        <div>
          <span
            class="mb-3 block text-xs lowercase tracking-[0.18em] text-[#aaa69b] md:tracking-[0.2em]"
          >
            album / 2026
          </span>

          <h2
            class="text-3xl font-normal leading-tight tracking-[-0.025em] text-[#f2eee3] sm:text-4xl md:text-6xl md:tracking-[-0.045em]"
          >
            scoria 24-26
          </h2>
        </div>

        <span
          class="max-w-sm text-sm lowercase leading-relaxed tracking-[0.06em] text-[#aaa69b] md:text-right md:tracking-[0.08em]"
        >
          breakcore / jungle / drum & bass / industrial electronics
        </span>
      </div>

      <!-- PLAYERS -->
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <!-- BANDCAMP -->
        <div
          class="border-b border-[#5f561f] p-5 sm:p-6 lg:border-b-0 lg:border-r lg:p-10"
        >
          <div class="mb-5 flex items-center justify-between gap-4">
            <span
              class="text-xs lowercase tracking-[0.18em] text-[#aaa69b] md:tracking-[0.2em]"
            >
              bandcamp
            </span>

            <a
              href="https://nightlampexecute.bandcamp.com/album/scoria-24-26"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs lowercase tracking-[0.12em] text-[#ffd800] underline-offset-4 hover:underline md:tracking-[0.15em]"
            >
              open ↗
            </a>
          </div>

          <iframe
            style="border: 0; width: 100%; height: 120px;"
            src="https://bandcamp.com/EmbeddedPlayer/album=2387949515/size=large/bgcol=050505/linkcol=ffd800/tracklist=false/artwork=small/transparent=true/"
            title="scoria 24-26 by nightlamp.exe on Bandcamp"
          >
            <a
              href="https://nightlampexecute.bandcamp.com/album/scoria-24-26"
            >
              scoria 24-26 by nightlamp.exe
            </a>
          </iframe>
        </div>

        <!-- SPOTIFY -->
        <div class="p-5 sm:p-6 lg:p-10">
          <div class="mb-5 flex items-center justify-between gap-4">
            <span
              class="text-xs lowercase tracking-[0.18em] text-[#aaa69b] md:tracking-[0.2em]"
            >
              spotify
            </span>

            <a
              href="https://open.spotify.com/album/6JEbZiYiLpWgBQeSnbchsj"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs lowercase tracking-[0.12em] text-[#ffd800] underline-offset-4 hover:underline md:tracking-[0.15em]"
            >
              open ↗
            </a>
          </div>

          <iframe
            src="https://open.spotify.com/embed/album/6JEbZiYiLpWgBQeSnbchsj?utm_source=generator&theme=0"
            width="100%"
            height="352"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
