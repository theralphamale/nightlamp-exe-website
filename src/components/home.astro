            class="spotify-player"
            title="scoria 24-26 by nightlamp.exe on Spotify"
          ></iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- LISTEN / FOLLOW -->
  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-20 md:px-10 md:pb-28"
  >
    <div class="mb-5 flex items-center gap-4">
      <span
        class="text-sm lowercase tracking-[0.16em] text-[#f2eee3] md:tracking-[0.2em]"
      >
        listen / follow
      </span>

      <div class="h-px flex-1 bg-[#5f561f]"></div>
    </div>

    <div
      class="grid grid-cols-1 border-l border-t border-[#5f561f] bg-[#050505]/65 backdrop-blur-[3px] md:grid-cols-2"
    >
      {
        links.map((link, index) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-h-28 items-end justify-between gap-4 border-b border-r border-[#5f561f] p-5 transition-all duration-200 hover:bg-[#ffd800] sm:min-h-32 sm:p-6 md:min-h-40"
          >
            <div class="min-w-0">
              <span
                class="mb-3 block text-sm text-[#ffd800] group-hover:text-black"
              >
                0{index + 1}
              </span>

              <span
                class="block break-words text-2xl font-normal tracking-[-0.025em] text-[#f2eee3] group-hover:text-black sm:text-3xl md:text-5xl md:tracking-[-0.035em]"
              >
                {link.name}
              </span>
            </div>

            <div class="shrink-0 text-right">
              <span
                class="mb-3 block text-xs lowercase tracking-[0.06em] text-[#aaa69b] group-hover:text-black sm:text-sm sm:tracking-[0.08em]"
              >
                {link.detail}
              </span>

              <span
                class="text-2xl text-[#ffd800] transition-transform duration-200 group-hover:translate-x-1 group-hover:text-black"
              >
                ↗
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <!-- CONTACT -->
  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-20 md:px-10 md:pb-28"
  >
    <div class="mb-5 flex items-center gap-4">
      <span
        class="text-sm lowercase tracking-[0.16em] text-[#f2eee3] md:tracking-[0.2em]"
      >
        contact
      </span>

      <div class="h-px flex-1 bg-[#5f561f]"></div>
    </div>

    <a
      href="mailto:nightlampexecute@gmail.com"
      class="group flex items-center justify-between gap-4 border border-[#5f561f] bg-[#050505]/65 p-5 transition-all duration-200 hover:border-[#ffd800] hover:bg-[#ffd800] sm:p-6 md:p-10"
    >
      <div class="min-w-0">
        <span
          class="mb-3 block text-[10px] lowercase tracking-[0.15em] text-[#aaa69b] group-hover:text-black sm:text-xs"
        >
          enquiries / press / bookings
        </span>

        <span
          class="block break-all text-lg font-normal tracking-[-0.015em] text-[#f2eee3] group-hover:text-black sm:text-2xl md:text-4xl"
        >
          nightlampexecute@gmail.com
        </span>
      </div>

      <span
        class="shrink-0 text-2xl text-[#ffd800] transition-transform duration-200 group-hover:translate-x-1 group-hover:text-black md:text-3xl"
        aria-hidden="true"
      >
        ↗
      </span>
    </a>
  </div>

  <!-- FOOTER -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl justify-between border-t border-[#5f561f] px-6 py-5 text-[10px] lowercase tracking-[0.12em] text-[#aaa69b] sm:text-xs sm:tracking-[0.15em] md:px-10"
  >
    <span>nightlamp.exe</span>
    <span>ireland</span>
  </div>
</section>

<script>
  type BinaryCharacter = {
    value: "0" | "1";
    opacity: number;
  };

  const canvas = document.querySelector("#binary-background");

  if (canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");

    if (ctx) {
      let width = 0;
      let height = 0;
      let columns = 0;
      let rows = 0;
      let lastUpdate = 0;
      let resizeTimer: number | undefined;

      const fontSize = 15;
      const charWidth = 11;
      const charHeight = 20;

      let characters: BinaryCharacter[] = [];

      const randomBinary = (): "0" | "1" => {
        return Math.random() > 0.5 ? "1" : "0";
      };

      const initialise = (): void => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        width = window.innerWidth;
        height = window.innerHeight;

        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);

        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        columns = Math.ceil(width / charWidth);
        rows = Math.ceil(height / charHeight);

        characters = Array.from(
          { length: columns * rows },
          (): BinaryCharacter => ({
            value: randomBinary(),
            opacity: 0.08 + Math.random() * 0.3,
          })
        );

        draw();
      };

      const draw = (): void => {
        ctx.clearRect(0, 0, width, height);

        ctx.font = `${fontSize}px monospace`;
        ctx.textBaseline = "top";

        characters.forEach(
          (character: BinaryCharacter, index: number): void => {
            const x = (index % columns) * charWidth;
            const y = Math.floor(index / columns) * charHeight;

            ctx.fillStyle = `rgba(255, 216, 0, ${character.opacity})`;

            ctx.fillText(
              character.value,
              x,
              y
            );
          }
        );
      };

      const update = (): void => {
        if (characters.length === 0) {
          return;
        }

        const amountToChange = Math.max(
          1,
          Math.floor(characters.length * 0.035)
        );

        for (let i = 0; i < amountToChange; i++) {
          const index = Math.floor(
            Math.random() * characters.length
          );

          const character = characters[index];

          if (!character) {
            continue;
          }

          character.value = randomBinary();
          character.opacity = 0.08 + Math.random() * 0.38;
        }
      };

      const animate = (time: number): void => {
        if (time - lastUpdate > 55) {
          update();
          draw();
          lastUpdate = time;
        }

        window.requestAnimationFrame(animate);
      };

      const handleResize = (): void => {
        if (resizeTimer !== undefined) {
          window.clearTimeout(resizeTimer);
        }

        resizeTimer = window.setTimeout((): void => {
          initialise();
        }, 150);
      };

      initialise();

      window.requestAnimationFrame(animate);

      window.addEventListener(
        "resize",
        handleResize
      );
    }
  }
</script>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500;6..96,600&display=swap");

  html,
  body {
    margin: 0;
    background: #050505;
    overflow-x: hidden;
  }

  .nightlamp-font {
    font-family:
      "Bodoni Moda",
      "Bodoni 72",
      Didot,
      "Times New Roman",
      serif;
  }

  .nightlamp-title {
    font-family:
      "Bodoni Moda",
      "Bodoni 72",
      Didot,
      "Times New Roman",
      serif;

    font-weight: 400;
    font-optical-sizing: auto;
  }

  .nightlamp-home-title {
    font-size: clamp(2.5rem, 12.5vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.025em;
    white-space: nowrap;
    word-break: normal;
    overflow-wrap: normal;
  }

  @media (min-width: 640px) {
    .nightlamp-home-title {
      font-size: clamp(4.5rem, 13vw, 9rem);
      line-height: 0.82;
      letter-spacing: -0.055em;
    }
  }

  @media (min-width: 1024px) {
    .nightlamp-home-title {
      font-size: 9rem;
      line-height: 0.78;
      letter-spacing: -0.07em;
    }
  }

  .background-grid {
    background-image:
      linear-gradient(
        rgba(255, 216, 0, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 216, 0, 0.025) 1px,
        transparent 1px
      );

    background-size: 48px 48px;

    mask-image: linear-gradient(
      to bottom,
      black,
      transparent 95%
    );
  }

  #home::before {
    content: "";
    position: fixed;
    z-index: 3;

    width: 650px;
    height: 650px;

    right: -300px;
    top: 60px;

    background: #ffd800;
    opacity: 0.04;

    filter: blur(120px);
    border-radius: 9999px;

    pointer-events: none;
  }

  #home::after {
    content: "";
    position: fixed;
    z-index: 3;

    width: 450px;
    height: 450px;

    left: -250px;
    bottom: 100px;

    background: #ffd800;
    opacity: 0.02;

    filter: blur(120px);
    border-radius: 9999px;

    pointer-events: none;
  }

  .spotify-player {
    display: block;
    max-width: 100%;
    border: 0;
    border-radius: 0;
  }

  iframe {
    max-width: 100%;
  }

  p {
    overflow-wrap: break-word;
  }

  ::selection {
    background: #ffd800;
    color: #000000;
  }
</style>
