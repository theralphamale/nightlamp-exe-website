---
const links = [
  {
    name: "BANDCAMP",
    url: "https://YOUR-BANDCAMP-URL",
    detail: "music / downloads",
  },
  {
    name: "SPOTIFY",
    url: "https://YOUR-SPOTIFY-URL",
    detail: "stream",
  },
  {
    name: "SOUNDCLOUD",
    url: "https://YOUR-SOUNDCLOUD-URL",
    detail: "tracks / mixes",
  },
  {
    name: "INSTAGRAM",
    url: "https://YOUR-INSTAGRAM-URL",
    detail: "updates",
  },
];
---

<section
  id="home"
  class="relative min-h-screen overflow-hidden bg-[#050505] text-[#ededed]"
>
  <!-- faint background grid -->
  <div class="background-grid absolute inset-0 pointer-events-none"></div>

  <!-- top label -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl items-center justify-between px-6 pt-6 md:px-10"
  >
    <span class="font-mono text-xs uppercase tracking-[0.25em] text-[#8d8d8d]">
      independent electronic music
    </span>

    <span class="hidden font-mono text-xs uppercase tracking-[0.25em] text-[#8d8d8d] sm:block">
      nightlampexecute.com
    </span>
  </div>

  <!-- hero -->
  <div
    class="relative z-10 mx-auto flex min-h-[72vh] w-full max-w-7xl flex-col justify-center px-6 py-20 md:px-10"
  >
    <p
      class="mb-5 font-mono text-xs uppercase tracking-[0.35em] text-[#b7ff00]"
    >
      nightlamp.exe
    </p>

    <h1
      class="max-w-6xl break-words text-[15vw] font-black leading-[0.78] tracking-[-0.075em] text-white sm:text-[12vw] lg:text-[9rem]"
    >
      NIGHTLAMP<br />
      <span class="text-[#b7ff00]">.EXE</span>
    </h1>

    <div class="mt-12 max-w-2xl border-l border-[#b7ff00] pl-5">
      <p class="text-lg leading-relaxed text-[#bdbdbd] md:text-xl">
        nightlamp.exe is an independent electronic project working across
        breakbeats, distortion, jungle, techno and experimental club music.
      </p>
    </div>
  </div>

  <!-- links -->
  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-20 md:px-10 md:pb-28"
  >
    <div class="mb-5 flex items-center gap-4">
      <span class="font-mono text-xs uppercase tracking-[0.3em] text-[#8d8d8d]">
        listen / follow
      </span>

      <div class="h-px flex-1 bg-[#252525]"></div>
    </div>

    <div class="grid grid-cols-1 border-l border-t border-[#292929] md:grid-cols-2">
      {
        links.map((link, index) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-h-32 items-end justify-between border-b border-r border-[#292929] p-6 transition-all duration-200 hover:bg-[#b7ff00] md:min-h-40"
          >
            <div>
              <span class="mb-2 block font-mono text-xs text-[#666] group-hover:text-black">
                0{index + 1}
              </span>

              <span class="text-2xl font-bold tracking-tight text-white group-hover:text-black md:text-3xl">
                {link.name}
              </span>
            </div>

            <div class="text-right">
              <span class="mb-3 block font-mono text-xs uppercase tracking-widest text-[#666] group-hover:text-black">
                {link.detail}
              </span>

              <span class="text-xl text-[#b7ff00] transition-transform duration-200 group-hover:translate-x-1 group-hover:text-black">
                ↗
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <!-- bottom -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl justify-between border-t border-[#202020] px-6 py-5 font-mono text-[10px] uppercase tracking-[0.2em] text-[#555] md:px-10"
  >
    <span>nightlamp.exe</span>
    <span>ireland</span>
  </div>
</section>

<style>
  .background-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  #home::before {
    content: "";
    position: absolute;
    width: 550px;
    height: 550px;
    right: -250px;
    top: 100px;
    background: #b7ff00;
    opacity: 0.035;
    filter: blur(100px);
    border-radius: 9999px;
    pointer-events: none;
  }

  ::selection {
    background: #b7ff00;
    color: #000;
  }
</style>
