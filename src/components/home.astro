---
const links = [
  {
    name: "BANDCAMP",
    url: "https://nightlampexecute.bandcamp.com/",
    detail: "music / downloads",
  },
  {
    name: "SPOTIFY",
    url: "https://open.spotify.com/artist/2jEIRuYF0JnnR6jtAMRBcq",
    detail: "stream",
  },
  {
    name: "SOUNDCLOUD",
    url: "https://soundcloud.com/nightlampexecute",
    detail: "tracks / mixes",
  },
  {
    name: "INSTAGRAM",
    url: "https://www.instagram.com/nightlamp.exe/",
    detail: "updates",
  },
];
---

<section
  id="home"
  class="nightlamp-font relative min-h-screen overflow-hidden bg-[#050505] text-[#ffd800]"
>
  <!-- ANIMATED BINARY BACKGROUND -->
  <canvas
    id="binary-background"
    class="pointer-events-none absolute inset-0 z-0 h-full w-full"
    aria-hidden="true"
  ></canvas>

  <!-- DARK OVERLAY -->
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-b from-[#050505]/20 via-[#050505]/55 to-[#050505]"
  ></div>

  <!-- GRID -->
  <div
    class="background-grid pointer-events-none absolute inset-0 z-[2]"
  ></div>

  <!-- TOP BAR -->
  <div
    class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-[1fr_auto_1fr] items-center px-6 pt-6 md:px-10"
  >
    <!-- LEFT -->
    <span
      class="text-xs lowercase tracking-[0.2em] text-[#ffd800]"
    >
      nightlampexecute.com
    </span>

    <!-- CENTRE NAV -->
    <nav
      class="flex items-center justify-center gap-3 whitespace-nowrap text-xs lowercase tracking-[0.2em] text-[#ffd800]"
      aria-label="Main navigation"
    >
      <a
        href="/"
        class="underline underline-offset-4"
        aria-current="page"
      >
        home
      </a>

      <span
        class="text-[#ffd800]/45"
        aria-hidden="true"
      >
        /
      </span>

      <a
        href="/press"
        class="underline-offset-4 transition-opacity hover:opacity-60 hover:underline"
      >
        press
      </a>
    </nav>

    <!-- RIGHT -->
    <span
      class="text-right text-xs lowercase tracking-[0.2em] text-[#ffd800]"
    >
      a product of Limerick City, Ireland
    </span>
  </div>

  <!-- HERO -->
  <div
    class="relative z-10 mx-auto flex min-h-[72vh] w-full max-w-7xl flex-col justify-center px-6 py-20 md:px-10"
  >
    <h1
      class="nightlamp-title max-w-6xl break-words text-[16vw] font-normal leading-[0.78] tracking-[-0.07em] text-[#ffd800] sm:text-[13vw] lg:text-[9rem]"
    >
      nightlamp.exe
    </h1>

    <div
      class="mt-12 max-w-2xl border-l border-[#ffd800] bg-[#050505]/30 pl-5 backdrop-blur-[2px]"
    >
      <p
        class="text-xl font-normal leading-relaxed text-[#ffd800] md:text-2xl"
      >
        nightlamp.exe is an independent electronic project working across
        industrial-influenced IDM, breakcore and experimental club music.
      </p>
    </div>
  </div>

  <!-- SCORIA 24–26 -->
  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-20 md:px-10 md:pb-28"
  >
    <div
      class="mb-5 flex items-center gap-4"
    >
      <span
        class="text-sm lowercase tracking-[0.2em] text-[#ffd800]"
      >
        scoria 24–26
      </span>

      <div
        class="h-px flex-1 bg-[#665700]"
      ></div>
    </div>

    <div
      class="border border-[#665700] bg-[#050505]/70 backdrop-blur-[3px]"
    >
      <!-- RELEASE HEADER -->
      <div
        class="flex flex-col gap-4 border-b border-[#665700] p-6 md:flex-row md:items-end md:justify-between md:p-10"
      >
        <div>
          <span
            class="mb-3 block text-xs lowercase tracking-[0.2em] text-[#ffd800]/55"
          >
            album / 2026
          </span>

          <h2
            class="text-4xl font-normal tracking-[-0.045em] text-[#ffd800] md:text-6xl"
          >
            scoria 24–26
          </h2>
        </div>

        <span
          class="max-w-sm text-sm lowercase leading-relaxed tracking-[0.08em] text-[#ffd800]/65 md:text-right"
        >
          breakcore / jungle / drum & bass / industrial electronics
        </span>
      </div>

      <!-- PLAYERS -->
      <div
        class="grid grid-cols-1 lg:grid-cols-2"
      >
        <!-- BANDCAMP -->
        <div
          class="border-b border-[#665700] p-6 lg:border-b-0 lg:border-r lg:p-10"
        >
          <div
            class="mb-5 flex items-center justify-between"
          >
            <span
              class="text-xs lowercase tracking-[0.2em] text-[#ffd800]/55"
            >
              bandcamp
            </span>

            <a
              href="https://nightlampexecute.bandcamp.com/album/scoria-24-26"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs lowercase tracking-[0.15em] text-[#ffd800] underline-offset-4 hover:underline"
            >
              open ↗
            </a>
          </div>

          <iframe
            style="border: 0; width: 100%; height: 120px;"
            src="https://bandcamp.com/EmbeddedPlayer/album=2387949515/size=large/bgcol=050505/linkcol=ffd800/tracklist=false/artwork=small/transparent=true/"
            seamless
            title="scoria 24–26 by nightlamp.exe on Bandcamp"
          >
            <a
              href="https://nightlampexecute.bandcamp.com/album/scoria-24-26"
            >
              scoria 24–26 by nightlamp.exe
            </a>
          </iframe>
        </div>

        <!-- SPOTIFY -->
        <div
          class="p-6 lg:p-10"
        >
          <div
            class="mb-5 flex items-center justify-between"
          >
            <span
              class="text-xs lowercase tracking-[0.2em] text-[#ffd800]/55"
            >
              spotify
            </span>

            <a
              href="https://open.spotify.com/album/6JEbZiYiLpWgBQeSnbchsj"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs lowercase tracking-[0.15em] text-[#ffd800] underline-offset-4 hover:underline"
            >
              open ↗
            </a>
          </div>

          <iframe
            src="https://open.spotify.com/embed/album/6JEbZiYiLpWgBQeSnbchsj?utm_source=generator&theme=0"
            width="100%"
            height="352"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            class="spotify-player"
            title="scoria 24–26 by nightlamp.exe on Spotify"
          ></iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- LISTEN / FOLLOW -->
  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-20 md:px-10 md:pb-28"
  >
    <div
      class="mb-5 flex items-center gap-4"
    >
      <span
        class="text-sm lowercase tracking-[0.2em] text-[#ffd800]"
      >
        listen / follow
      </span>

      <div
        class="h-px flex-1 bg-[#665700]"
      ></div>
    </div>

    <div
      class="grid grid-cols-1 border-l border-t border-[#665700] bg-[#050505]/60 backdrop-blur-[3px] md:grid-cols-2"
    >
      {
        links.map((link, index) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex min-h-32 items-end justify-between border-b border-r border-[#665700] p-6 transition-all duration-200 hover:bg-[#ffd800] md:min-h-40"
          >
            <div>
              <span
                class="mb-3 block text-sm text-[#ffd800] group-hover:text-black"
              >
                0{index + 1}
              </span>

              <span
                class="block text-3xl font-normal tracking-[-0.035em] text-[#ffd800] group-hover:text-black md:text-5xl"
              >
                {link.name}
              </span>
            </div>

            <div
              class="text-right"
            >
              <span
                class="mb-3 block text-sm lowercase tracking-[0.08em] text-[#ffd800] group-hover:text-black"
              >
                {link.detail}
              </span>

              <span
                class="text-2xl text-[#ffd800] transition-transform duration-200 group-hover:translate-x-1 group-hover:text-black"
              >
                ↗
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <!-- FOOTER -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl justify-between border-t border-[#665700] px-6 py-5 text-xs lowercase tracking-[0.15em] text-[#ffd800] md:px-10"
  >
    <span>nightlamp.exe</span>
    <span>ireland</span>
  </div>
</section>

<script>
  type BinaryCharacter = {
    value: "0" | "1";
    opacity: number;
  };

  const canvas =
    document.querySelector(
      "#binary-background"
    );

  if (
    canvas instanceof
    HTMLCanvasElement
  ) {
    const ctx =
      canvas.getContext("2d");

    if (ctx) {
      let width = 0;
      let height = 0;
      let columns = 0;
      let rows = 0;

      let lastUpdate = 0;

      let resizeTimer:
        number | undefined;

      const fontSize = 15;
      const charWidth = 11;
      const charHeight = 20;

      let characters:
        BinaryCharacter[] = [];

      const randomBinary =
        (): "0" | "1" => {
          return Math.random() > 0.5
            ? "1"
            : "0";
        };

      const initialise =
        (): void => {
          const section =
            document.querySelector(
              "#home"
            );

          if (
            !(
              section instanceof
              HTMLElement
            )
          ) {
            return;
          }

          const rect =
            section.getBoundingClientRect();

          const dpr =
            window.devicePixelRatio ||
            1;

          width = rect.width;
          height = rect.height;

          canvas.width =
            Math.floor(
              width * dpr
            );

          canvas.height =
            Math.floor(
              height * dpr
            );

          canvas.style.width =
            `${width}px`;

          canvas.style.height =
            `${height}px`;

          ctx.setTransform(
            dpr,
            0,
            0,
            dpr,
            0,
            0
          );

          columns =
            Math.ceil(
              width /
                charWidth
            );

          rows =
            Math.ceil(
              height /
                charHeight
            );

          characters =
            Array.from(
              {
                length:
                  columns *
                  rows,
              },
              (): BinaryCharacter => ({
                value:
                  randomBinary(),

                opacity:
                  0.08 +
                  Math.random() *
                    0.3,
              })
            );

          draw();
        };

      const draw =
        (): void => {
          ctx.clearRect(
            0,
            0,
            width,
            height
          );

          ctx.font =
            `${fontSize}px monospace`;

          ctx.textBaseline =
            "top";

          characters.forEach(
            (
              character:
                BinaryCharacter,
              index: number
            ): void => {
              const x =
                (index %
                  columns) *
                charWidth;

              const y =
                Math.floor(
                  index /
                    columns
                ) *
                charHeight;

              ctx.fillStyle =
                `rgba(255, 216, 0, ${character.opacity})`;

              ctx.fillText(
                character.value,
                x,
                y
              );
            }
          );
        };

      const update =
        (): void => {
          if (
            characters.length ===
            0
          ) {
            return;
          }

          const amountToChange =
            Math.max(
              1,

              Math.floor(
                characters.length *
                  0.035
              )
            );

          for (
            let i = 0;
            i <
            amountToChange;
            i++
          ) {
            const index =
              Math.floor(
                Math.random() *
                  characters.length
              );

            const character =
              characters[index];

            if (!character) {
              continue;
            }

            character.value =
              randomBinary();

            character.opacity =
              0.08 +
              Math.random() *
                0.38;
          }
        };

      const animate = (
        time: number
      ): void => {
        if (
          time -
            lastUpdate >
          55
        ) {
          update();
          draw();

          lastUpdate =
            time;
        }

        window.requestAnimationFrame(
          animate
        );
      };

      const handleResize =
        (): void => {
          if (
            resizeTimer !==
            undefined
          ) {
            window.clearTimeout(
              resizeTimer
            );
          }

          resizeTimer =
            window.setTimeout(
              (): void => {
                initialise();
              },
              150
            );
        };

      initialise();

      window.requestAnimationFrame(
        animate
      );

      window.addEventListener(
        "resize",
        handleResize
      );
    }
  }
</script>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500;6..96,600&display=swap");

  html,
  body {
    margin: 0;
    background: #050505;
  }

  .nightlamp-font {
    font-family:
      "Bodoni Moda",
      "Bodoni 72",
      Didot,
      "Times New Roman",
      serif;
  }

  .nightlamp-title {
    font-family:
      "Bodoni Moda",
      "Bodoni 72",
      Didot,
      "Times New Roman",
      serif;

    font-weight: 400;
    font-optical-sizing: auto;
  }

  .background-grid {
    background-image:
      linear-gradient(
        rgba(
            255,
            216,
            0,
            0.025
          )
          1px,
        transparent
          1px
      ),
      linear-gradient(
        90deg,
        rgba(
            255,
            216,
            0,
            0.025
          )
          1px,
        transparent
          1px
      );

    background-size:
      48px 48px;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent
          95%
      );
  }

  #home::before {
    content: "";

    position: absolute;

    z-index: 3;

    width: 650px;
    height: 650px;

    right: -300px;
    top: 60px;

    background:
      #ffd800;

    opacity: 0.045;

    filter:
      blur(120px);

    border-radius:
      9999px;

    pointer-events:
      none;
  }

  #home::after {
    content: "";

    position: absolute;

    z-index: 3;

    width: 450px;
    height: 450px;

    left: -250px;
    bottom: 100px;

    background:
      #ffd800;

    opacity: 0.025;

    filter:
      blur(120px);

    border-radius:
      9999px;

    pointer-events:
      none;
  }

  .spotify-player {
    display: block;
    border: 0;
    border-radius: 0;
  }

  ::selection {
    background:
      #ffd800;

    color:
      #000000;
  }

  @media (max-width: 640px) {
    #home nav {
      letter-spacing:
        0.12em;
    }
  }
</style>
