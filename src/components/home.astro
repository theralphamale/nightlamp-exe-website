<script>
  const canvas = document.querySelector("#binary-background");

  type BinaryCharacter = {
    value: "0" | "1";
    opacity: number;
  };

  if (canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");

    if (ctx) {
      let width = 0;
      let height = 0;
      let columns = 0;
      let rows = 0;

      let animationFrame = 0;
      let lastUpdate = 0;
      let resizeTimer: number | undefined;

      const fontSize = 15;
      const charWidth = 11;
      const charHeight = 20;

      let characters: BinaryCharacter[] = [];

      const randomBinary = (): "0" | "1" => {
        return Math.random() > 0.5 ? "1" : "0";
      };

      const initialise = (): void => {
        const section = document.querySelector("#home");

        if (!(section instanceof HTMLElement)) {
          return;
        }

        const rect = section.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;

        width = rect.width;
        height = rect.height;

        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);

        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        columns = Math.ceil(width / charWidth);
        rows = Math.ceil(height / charHeight);

        characters = Array.from(
          { length: columns * rows },
          (): BinaryCharacter => ({
            value: randomBinary(),
            opacity: 0.08 + Math.random() * 0.28,
          })
        );

        draw();
      };

      const draw = (): void => {
        ctx.clearRect(0, 0, width, height);

        ctx.font = `${fontSize}px monospace`;
        ctx.textBaseline = "top";

        characters.forEach(
          (character: BinaryCharacter, index: number): void => {
            const x = (index % columns) * charWidth;
            const y = Math.floor(index / columns) * charHeight;

            ctx.fillStyle = `rgba(255, 216, 0, ${character.opacity})`;
            ctx.fillText(character.value, x, y);
          }
        );
      };

      const update = (): void => {
        if (characters.length === 0) {
          return;
        }

        const amountToChange = Math.max(
          1,
          Math.floor(characters.length * 0.035)
        );

        for (let i = 0; i < amountToChange; i++) {
          const index = Math.floor(Math.random() * characters.length);

          const character = characters[index];

          if (!character) {
            continue;
          }

          character.value = randomBinary();
          character.opacity = 0.08 + Math.random() * 0.35;
        }
      };

      const animate = (time: number): void => {
        if (time - lastUpdate > 55) {
          update();
          draw();

          lastUpdate = time;
        }

        animationFrame = window.requestAnimationFrame(animate);
      };

      const handleResize = (): void => {
        if (resizeTimer !== undefined) {
          window.clearTimeout(resizeTimer);
        }

        resizeTimer = window.setTimeout((): void => {
          initialise();
        }, 150);
      };

      const cleanup = (): void => {
        window.cancelAnimationFrame(animationFrame);

        if (resizeTimer !== undefined) {
          window.clearTimeout(resizeTimer);
        }

        window.removeEventListener("resize", handleResize);
      };

      initialise();

      animationFrame = window.requestAnimationFrame(animate);

      window.addEventListener("resize", handleResize);

      document.addEventListener("astro:before-swap", cleanup, {
        once: true,
      });
    }
  }
</script>
