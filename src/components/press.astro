---
const pressPhotos = [
  {
    number: "01",
    image: "/press/nightlamp-press-01.png",
    download: "/press/nightlamp-press-01.png",
    alt: "nightlamp.exe press photograph 01",
  },
  {
    number: "02",
    image: "/press/nightlamp-press-02.png",
    download: "/press/nightlamp-press-02.png",
    alt: "nightlamp.exe press photograph 02",
  },
];
---

<section
  id="press"
  class="nightlamp-font relative min-h-screen overflow-hidden bg-[#050505] text-[#ffd800]"
>
  <canvas
    id="press-binary-background"
    class="pointer-events-none fixed inset-0 z-0 h-screen w-screen"
    aria-hidden="true"
  ></canvas>

  <div
    class="pointer-events-none fixed inset-0 z-[1] bg-gradient-to-b from-[#050505]/25 via-[#050505]/60 to-[#050505]/90"
  ></div>

  <div
    class="press-grid pointer-events-none fixed inset-0 z-[2]"
  ></div>

  <!-- TOP BAR -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl items-center justify-between px-6 pt-6 md:px-10"
  >
    <a
      href="/"
      class="text-xs lowercase tracking-[0.2em] text-[#ffd800] underline-offset-4 hover:underline"
    >
      ← nightlampexecute.com
    </a>

    <span
      class="text-right text-xs lowercase tracking-[0.2em] text-[#ffd800]"
    >
      press
    </span>
  </div>

  <!-- HERO / BIO -->
  <div
    class="relative z-10 mx-auto flex min-h-[70vh] w-full max-w-7xl flex-col justify-center px-6 py-20 md:px-10"
  >
    <span
      class="mb-6 text-xs lowercase tracking-[0.2em] text-[#ffd800]/60"
    >
      Limerick City, Ireland
    </span>

    <h1
      class="nightlamp-title max-w-6xl break-words text-[18vw] font-normal leading-[0.78] tracking-[-0.07em] text-[#ffd800] sm:text-[14vw] lg:text-[9rem]"
    >
      press
    </h1>

    <div
      class="mt-12 max-w-4xl border-l border-[#ffd800] bg-[#050505]/30 pl-5 backdrop-blur-[2px]"
    >
      <p
        class="text-xl font-normal leading-relaxed text-[#ffd800] md:text-2xl"
      >
        nightlamp.exe is the electronic project of Limerick musician and
        producer Kieran Ralph. Drawing from breakcore, jungle, drum & bass,
        techno and industrial electronic music, the project combines
        distorted breakbeats, abrasive production and dense rhythmic
        structures with melodic material.
      </p>

      <p
        class="mt-8 text-xl font-normal leading-relaxed text-[#ffd800] md:text-2xl"
      >
        <em>scoria 24–26</em> brings together material developed between
        2024 and 2026 and forms the first substantial collection released
        under the nightlamp.exe name.
      </p>
    </div>
  </div>

  <!-- PRESS PHOTOS -->
  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 pb-24 md:px-10 md:pb-32"
  >
    <div class="mb-5 flex items-center gap-4">
      <span
        class="text-sm lowercase tracking-[0.2em]"
      >
        press photographs
      </span>

      <div class="h-px flex-1 bg-[#665700]"></div>
    </div>

    <div
      class="grid grid-cols-1 border-l border-t border-[#665700] bg-[#050505]/75 backdrop-blur-[3px] md:grid-cols-2"
    >
      {
        pressPhotos.map((photo) => (
          <article
            class="border-b border-r border-[#665700] p-4 md:p-6"
          >
            <a
              href={photo.image}
              target="_blank"
              rel="noopener noreferrer"
              class="block overflow-hidden bg-[#0a0a0a]"
            >
              <img
                src={photo.image}
                alt={photo.alt}
                class="press-image block h-auto w-full transition-opacity duration-200 hover:opacity-80"
                loading="lazy"
              />
            </a>

            <div
              class="mt-5 flex items-end justify-between gap-4"
            >
              <div>
                <span
                  class="block text-xs lowercase tracking-[0.15em] text-[#ffd800]/50"
                >
                  press photograph
                </span>

                <span
                  class="mt-1 block text-xl"
                >
                  {photo.number}
                </span>
              </div>

              <a
                href={photo.download}
                download
                class="border border-[#665700] px-4 py-3 text-xs lowercase tracking-[0.15em] transition-colors hover:border-[#ffd800] hover:bg-[#ffd800] hover:text-black"
              >
                high-res ↓
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <p
      class="mt-4 text-xs lowercase tracking-[0.12em] text-[#ffd800]/40"
    >
      photographs may be used for editorial / press coverage of nightlamp.exe
    </p>
  </div>

  <!-- FOOTER -->
  <div
    class="relative z-10 mx-auto flex w-full max-w-7xl items-center justify-between border-t border-[#665700] px-6 py-5 text-xs lowercase tracking-[0.15em] text-[#ffd800] md:px-10"
  >
    <span>nightlamp.exe</span>

    <a
      href="/"
      class="underline-offset-4 hover:underline"
    >
      home
    </a>

    <span>ireland</span>
  </div>
</section>

<script>
  type BinaryCharacter = {
    value: "0" | "1";
    opacity: number;
  };

  const canvas = document.querySelector(
    "#press-binary-background"
  );

  if (canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");

    if (ctx) {
      let width = 0;
      let height = 0;
      let columns = 0;
      let rows = 0;
      let lastUpdate = 0;
      let resizeTimer: number | undefined;

      const fontSize = 15;
      const charWidth = 11;
      const charHeight = 20;

      let characters: BinaryCharacter[] = [];

      const randomBinary = (): "0" | "1" => {
        return Math.random() > 0.5 ? "1" : "0";
      };

      const initialise = (): void => {
        const dpr = window.devicePixelRatio || 1;

        width = window.innerWidth;
        height = window.innerHeight;

        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);

        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        columns = Math.ceil(width / charWidth);
        rows = Math.ceil(height / charHeight);

        characters = Array.from(
          { length: columns * rows },
          (): BinaryCharacter => ({
            value: randomBinary(),
            opacity: 0.08 + Math.random() * 0.3,
          })
        );

        draw();
      };

      const draw = (): void => {
        ctx.clearRect(0, 0, width, height);

        ctx.font = `${fontSize}px monospace`;
        ctx.textBaseline = "top";

        characters.forEach(
          (character: BinaryCharacter, index: number): void => {
            const x = (index % columns) * charWidth;
            const y = Math.floor(index / columns) * charHeight;

            ctx.fillStyle = `rgba(255, 216, 0, ${character.opacity})`;

            ctx.fillText(
              character.value,
              x,
              y
            );
          }
        );
      };

      const update = (): void => {
        if (characters.length === 0) {
          return;
        }

        const amountToChange =
          Math.max(
            1,
            Math.floor(
              characters.length * 0.035
            )
          );

        for (
          let i = 0;
          i < amountToChange;
          i++
        ) {
          const index =
            Math.floor(
              Math.random() *
              characters.length
            );

          const character =
            characters[index];

          if (!character) {
            continue;
          }

          character.value =
            randomBinary();

          character.opacity =
            0.08 +
            Math.random() *
            0.38;
        }
      };

      const animate = (
        time: number
      ): void => {
        if (
          time - lastUpdate >
          55
        ) {
          update();
          draw();
          lastUpdate = time;
        }

        window.requestAnimationFrame(
          animate
        );
      };

      const handleResize =
        (): void => {
          if (
            resizeTimer !==
            undefined
          ) {
            window.clearTimeout(
              resizeTimer
            );
          }

          resizeTimer =
            window.setTimeout(
              (): void => {
                initialise();
              },
              150
            );
        };

      initialise();

      window.requestAnimationFrame(
        animate
      );

      window.addEventListener(
        "resize",
        handleResize
      );
    }
  }
</script>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500;6..96,600&display=swap");

  html,
  body {
    margin: 0;
    background: #050505;
  }

  .nightlamp-font {
    font-family:
      "Bodoni Moda",
      "Bodoni 72",
      Didot,
      "Times New Roman",
      serif;
  }

  .nightlamp-title {
    font-family:
      "Bodoni Moda",
      "Bodoni 72",
      Didot,
      "Times New Roman",
      serif;

    font-weight: 400;
    font-optical-sizing: auto;
  }

  .press-grid {
    background-image:
      linear-gradient(
        rgba(255, 216, 0, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 216, 0, 0.025) 1px,
        transparent 1px
      );

    background-size: 48px 48px;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 95%
      );
  }

  #press::before {
    content: "";

    position: fixed;

    z-index: 3;

    width: 650px;
    height: 650px;

    right: -300px;
    top: 60px;

    background: #ffd800;

    opacity: 0.04;

    filter: blur(120px);

    border-radius: 9999px;

    pointer-events: none;
  }

  #press::after {
    content: "";

    position: fixed;

    z-index: 3;

    width: 450px;
    height: 450px;

    left: -250px;
    bottom: 100px;

    background: #ffd800;

    opacity: 0.025;

    filter: blur(120px);

    border-radius: 9999px;

    pointer-events: none;
  }

  .press-image {
    background: #111111;

    filter:
      grayscale(85%)
      contrast(1.03);
  }

  ::selection {
    background: #ffd800;
    color: #000000;
  }
</style>
