    background: #050505;
  }

  .nightlamp-font {
    font-family:
      "Bodoni Moda",
      "Bodoni 72",
      Didot,
      "Times New Roman",
      serif;
  }

  .nightlamp-title {
    font-family:
      "Bodoni Moda",
      "Bodoni 72",
      Didot,
      "Times New Roman",
      serif;

    font-weight: 400;
    font-optical-sizing: auto;
  }

  .press-grid {
    background-image:
      linear-gradient(
        rgba(255, 216, 0, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 216, 0, 0.025) 1px,
        transparent 1px
      );

    background-size: 48px 48px;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 95%
      );
  }

  #press::before {
    content: "";

    position: fixed;

    z-index: 3;

    width: 650px;
    height: 650px;

    right: -300px;
    top: 60px;

    background: #ffd800;

    opacity: 0.04;

    filter: blur(120px);

    border-radius: 9999px;

    pointer-events: none;
  }

  #press::after {
    content: "";

    position: fixed;

    z-index: 3;

    width: 450px;
    height: 450px;

    left: -250px;
    bottom: 100px;

    background: #ffd800;

    opacity: 0.025;

    filter: blur(120px);

    border-radius: 9999px;

    pointer-events: none;
  }

  .spotify-player {
    display: block;
    border: 0;
  }

  .press-image {
    background: #111111;

    filter:
      grayscale(85%)
      contrast(1.03);
  }

  .press-label {
    font-size: 0.75rem;

    text-transform: lowercase;

    letter-spacing: 0.15em;

    color:
      rgba(
        255,
        216,
        0,
        0.5
      );
  }

  .download-link {
    display: flex;

    min-height: 9rem;

    align-items: flex-end;

    justify-content:
      space-between;

    border-right:
      1px solid #665700;

    border-bottom:
      1px solid #665700;

    padding: 1.5rem;

    transition:
      background-color
      180ms ease,
      color
      180ms ease;
  }

  .download-link:hover {
    background: #ffd800;
    color: #000000;
  }

  .download-number {
    display: block;

    margin-bottom:
      0.75rem;

    font-size:
      0.75rem;
  }

  .download-title {
    display: block;

    font-size:
      1.75rem;

    letter-spacing:
      -0.035em;
