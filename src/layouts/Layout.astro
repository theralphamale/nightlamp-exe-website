---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <title>{title}</title>

    <meta
      name="description"
      content="nightlamp.exe is an independent electronic project from Limerick City, Ireland, working across industrial-influenced IDM, breakcore and experimental club music."
    />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <!-- FAVICON -->
    <link
      rel="icon"
      type="image/png"
      href="/web%20logo.png"
    />

    <!-- SITE URL -->
    <link
      rel="canonical"
      href="https://nightlampexecute.com/"
    />

    <!-- BROWSER COLOUR -->
    <meta
      name="theme-color"
      content="#050505"
    />

    <!-- OPEN GRAPH -->
    <meta
      property="og:title"
      content="nightlamp.exe"
    />

    <meta
      property="og:description"
      content="Independent electronic project from Limerick City, Ireland. Industrial-influenced IDM, breakcore and experimental club music."
    />

    <meta
      property="og:image"
      content="https://nightlampexecute.com/web%20logo.png"
    />

    <meta
      property="og:url"
      content="https://nightlampexecute.com/"
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="nightlamp.exe"
    />

    <!-- TWITTER / SOCIAL PREVIEW -->
    <meta
      name="twitter:card"
      content="summary"
    />

    <meta
      name="twitter:title"
      content="nightlamp.exe"
    />

    <meta
      name="twitter:description"
      content="Industrial-influenced IDM, breakcore and experimental club music from Limerick City, Ireland."
    />

    <meta
      name="twitter:image"
      content="https://nightlampexecute.com/web%20logo.png"
    />

    <!-- STRUCTURED DATA -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "MusicGroup",
        "name": "nightlamp.exe",
        "url": "https://nightlampexecute.com/",
        "image": "https://nightlampexecute.com/web%20logo.png",
        "genre": [
          "IDM",
          "Breakcore",
          "Experimental Electronic",
          "Industrial"
        ],
        "sameAs": [
          "https://nightlampexecute.bandcamp.com/",
          "https://open.spotify.com/artist/2jEIRuYF0JnnR6jtAMRBcq",
          "https://soundcloud.com/nightlampexecute",
          "https://www.instagram.com/nightlamp.exe/"
        ],
        "description": "nightlamp.exe is an independent electronic project from Limerick City, Ireland, working across industrial-influenced IDM, breakcore and experimental club music."
      }
    </script>
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --background: #050505;
    --yellow: #ffd800;
  }

  html {
    margin: 0;
    padding: 0;
    background: var(--background);
  }

  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    background: var(--background);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  *::selection {
    background-color: var(--yellow);
    color: #000000;
  }

  /* Scrollbar */

  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: #050505;
  }

  ::-webkit-scrollbar-thumb {
    background: #665700;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #ffd800;
  }

  html {
    scrollbar-width: thin;
    scrollbar-color: #665700 #050505;
  }
</style>
